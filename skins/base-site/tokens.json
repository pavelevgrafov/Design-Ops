{
  "$schema": "https://design-tokens.org/schema/dtcg/2025-10",
  "$meta": { "name": "base-site", "description": "K2A base skin, site profile: editorial-neutral, professional. Applied automatically after Gate 1. Maintained as a flagship asset (contract tests on revision). v7.0: extended categories + dark layer + component layer.",
    "contrastPairs": [
      {"foreground": "ink", "background": "canvas"},
      {"foreground": "inkMuted", "background": "canvas"},
      {"foreground": "actionPrimaryText", "background": "actionPrimary"},
      {"foreground": "inkOnDark", "background": "surfaceDark"},
      {"foreground": "textPrimary", "background": "canvas"},
      {"foreground": "textSecondary", "background": "canvas"},
      {"foreground": "textTertiary", "background": "canvasRaised"}
    ]
  },
  "primitive": {
    "color": {
      "gray": {
        "50":  { "$value": "#fafaf9", "$type": "color" },
        "100": { "$value": "#f0efed", "$type": "color" },
        "200": { "$value": "#dddbd7", "$type": "color" },
        "300": { "$value": "#bfbcb6", "$type": "color" },
        "400": { "$value": "#8f8b85", "$type": "color" },
        "500": { "$value": "#6e6a64", "$type": "color" },
        "600": { "$value": "#4a4741", "$type": "color" },
        "700": { "$value": "#34322d", "$type": "color" },
        "800": { "$value": "#211f1c", "$type": "color" },
        "900": { "$value": "#141312", "$type": "color" }
      },
      "accent": {
        "300": { "$value": "#4cba8b", "$type": "color" },
        "500": { "$value": "#1e9468", "$type": "color" },
        "600": { "$value": "#0f6b3f", "$type": "color" },
        "700": { "$value": "#0a4e2f", "$type": "color" }
      },
      "semantic": {
        "comment": "Status hues are conventional (Jakob's law in color): red=error, green=success, amber=warning, blue=info. 'dark' variants are pre-adjusted for the dark layer (desaturated + lightened, cf. dark-theme-rules).",
        "error": {
          "500":  { "$value": "#d64545", "$type": "color" },
          "600":  { "$value": "#b93a3a", "$type": "color" },
          "dark": { "$value": "#cf6679", "$type": "color" }
        },
        "success": {
          "500":  { "$value": "#2f9e6e", "$type": "color" },
          "600":  { "$value": "#1e7a52", "$type": "color" },
          "dark": { "$value": "#7fb896", "$type": "color" }
        },
        "warning": {
          "500":  { "$value": "#e8a13c", "$type": "color" },
          "600":  { "$value": "#8f6300", "$type": "color" },
          "dark": { "$value": "#e3b76a", "$type": "color" }
        },
        "info": {
          "500":  { "$value": "#3d7dd8", "$type": "color" },
          "600":  { "$value": "#2f62b0", "$type": "color" },
          "dark": { "$value": "#7aa8e8", "$type": "color" }
        }
      }
    },
    "font": {
      "family": {
        "display": { "$value": ["Fraunces", "Georgia", "serif"], "$type": "fontFamily" },
        "text":    { "$value": ["Public Sans", "system-ui", "sans-serif"], "$type": "fontFamily" },
        "mono":    { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$type": "fontFamily" }
      },
      "scale": {
        "ratio":  { "$value": 1.25, "$type": "number" },
        "step-1": { "$value": "0.8rem",   "$type": "dimension" },
        "step0":  { "$value": "1rem",     "$type": "dimension" },
        "step1":  { "$value": "1.25rem",  "$type": "dimension" },
        "step2":  { "$value": "1.563rem", "$type": "dimension" },
        "step3":  { "$value": "1.953rem", "$type": "dimension" },
        "step4":  { "$value": "2.441rem", "$type": "dimension" },
        "step5":  { "$value": "3.052rem", "$type": "dimension" }
      },
      "size": {
        "comment": "Named aliases over the modular scale (knowledge/modular-type-scale); use these, not raw steps.",
        "xs":  { "$value": "{primitive.font.scale.step-1}", "$type": "dimension" },
        "sm":  { "$value": "{primitive.font.scale.step0}",  "$type": "dimension" },
        "md":  { "$value": "{primitive.font.scale.step1}",  "$type": "dimension" },
        "lg":  { "$value": "{primitive.font.scale.step2}",  "$type": "dimension" },
        "xl":  { "$value": "{primitive.font.scale.step3}",  "$type": "dimension" },
        "2xl": { "$value": "{primitive.font.scale.step4}",  "$type": "dimension" },
        "3xl": { "$value": "{primitive.font.scale.step5}",  "$type": "dimension" }
      },
      "weight": {
        "regular":  { "$value": 400, "$type": "number" },
        "medium":   { "$value": 500, "$type": "number" },
        "semibold": { "$value": 600, "$type": "number" },
        "bold":     { "$value": 700, "$type": "number" }
      },
      "tracking": {
        "tight":  { "$value": "-0.02em", "$type": "dimension" },
        "normal": { "$value": "0",       "$type": "dimension" },
        "wide":   { "$value": "0.05em",  "$type": "dimension" }
      },
      "lineHeight": {
        "tight":   { "$value": 1.15, "$type": "number" },
        "caption": { "$value": 1.35, "$type": "number" },
        "body":    { "$value": 1.6, "$type": "number" },
        "loose":   { "$value": 1.7, "$type": "number" }
      },
      "fluid": {
        "h1":   { "$value": "clamp(1.75rem, 4vw + 0.5rem, 3rem)", "$type": "string" },
        "body": { "$value": "clamp(1rem, 1.5vw + 0.5rem, 1.25rem)", "$type": "string" }
      }
    },
    "space": {
      "1": { "$value": "0.25rem", "$type": "dimension" },
      "2": { "$value": "0.5rem",  "$type": "dimension" },
      "3": { "$value": "0.75rem", "$type": "dimension" },
      "4": { "$value": "1rem",    "$type": "dimension" },
      "5": { "$value": "1.25rem", "$type": "dimension" },
      "6": { "$value": "1.5rem",  "$type": "dimension" },
      "8": { "$value": "2rem",    "$type": "dimension" },
      "12": { "$value": "3rem",   "$type": "dimension" },
      "16": { "$value": "4rem",   "$type": "dimension" },
      "24": { "$value": "6rem",   "$type": "dimension" }
    },
    "radius": {
      "sm":   { "$value": "0.25rem", "$type": "dimension" },
      "md":   { "$value": "0.5rem",  "$type": "dimension" },
      "lg":   { "$value": "1rem",    "$type": "dimension" },
      "full": { "$value": "9999px",  "$type": "dimension" }
    },
    "shadow": {
      "comment": "Two-layer shadows (near sharp + far soft), three elevations only (knowledge/depth via ux-wiki depth-surfaces).",
      "sm": { "$value": "0 1px 2px rgb(0 0 0 / 0.05), 0 1px 3px rgb(0 0 0 / 0.04)", "$type": "string" },
      "md": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.07), 0 2px 4px -2px rgb(0 0 0 / 0.05)", "$type": "string" },
      "lg": { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.08), 0 4px 6px -4px rgb(0 0 0 / 0.05)", "$type": "string" }
    },
    "motion": {
      "comment": "Duration bands 100-200 / 200-500 / 500-700 ms; linear easing forbidden (knowledge/motion-budgets).",
      "duration": {
        "fast":   { "$value": "150ms", "$type": "duration" },
        "normal": { "$value": "300ms", "$type": "duration" },
        "slow":   { "$value": "600ms", "$type": "duration" }
      },
      "easing": {
        "out":   { "$value": "cubic-bezier(0, 0, 0.2, 1)",    "$type": "string" },
        "in":    { "$value": "cubic-bezier(0.4, 0, 1, 1)",    "$type": "string" },
        "inOut": { "$value": "cubic-bezier(0.4, 0, 0.2, 1)",  "$type": "string" }
      },
      "spring": {
        "bounce":   { "$value": 0,       "$type": "number" },
        "duration": { "$value": "300ms", "$type": "duration" }
      }
    },
    "elevation": {
      "comment": "Dark-theme state overlays (white alpha on the raised surface), knowledge/dark-theme-rules.",
      "hover":   { "$value": 0.08, "$type": "number" },
      "focus":   { "$value": 0.12, "$type": "number" },
      "pressed": { "$value": 0.12, "$type": "number" },
      "drag":    { "$value": 0.16, "$type": "number" }
    }
  },
  "semantic": {
    "color": {
      "canvas":            { "$value": "{primitive.color.gray.50}",  "$type": "color" },
      "canvasRaised":      { "$value": "#ffffff",                    "$type": "color" },
      "ink":               { "$value": "{primitive.color.gray.900}", "$type": "color" },
      "inkMuted":          { "$value": "{primitive.color.gray.600}", "$type": "color" },
      "actionPrimary":     { "$value": "{primitive.color.accent.600}", "$type": "color" },
      "actionPrimaryText": { "$value": "#ffffff", "$type": "color" },
      "focusRing":         { "$value": "{primitive.color.accent.500}", "$type": "color" },
      "borderSubtle":      { "$value": "{primitive.color.gray.200}", "$type": "color" },
      "surfaceDark":       { "$value": "{primitive.color.gray.900}", "$type": "color" },
      "inkOnDark":         { "$value": "{primitive.color.gray.50}", "$type": "color" },
      "textPrimary":       { "$value": "{primitive.color.gray.900}", "$type": "color" },
      "textSecondary":     { "$value": "{primitive.color.gray.600}", "$type": "color" },
      "textTertiary":      { "$value": "{primitive.color.gray.400}", "$type": "color" },
      "semanticError":     { "$value": "{primitive.color.semantic.error.600}",   "$type": "color" },
      "semanticSuccess":   { "$value": "{primitive.color.semantic.success.600}", "$type": "color" },
      "semanticWarning":   { "$value": "{primitive.color.semantic.warning.600}", "$type": "color" },
      "semanticInfo":      { "$value": "{primitive.color.semantic.info.600}",    "$type": "color" }
    },
    "font": {
      "body":    { "$value": "{primitive.font.family.text}",    "$type": "fontFamily" },
      "display": { "$value": "{primitive.font.family.display}", "$type": "fontFamily" }
    },
    "measure": {
      "body": { "$value": "65ch", "$type": "dimension" }
    },
    "shadow": {
      "raised":  { "$value": "{primitive.shadow.sm}", "$type": "string" },
      "overlay": { "$value": "{primitive.shadow.md}", "$type": "string" },
      "modal":   { "$value": "{primitive.shadow.lg}", "$type": "string" }
    },
    "radius": {
      "control": { "$value": "{primitive.radius.sm}",   "$type": "dimension" },
      "card":    { "$value": "{primitive.radius.md}",   "$type": "dimension" },
      "pill":    { "$value": "{primitive.radius.full}", "$type": "dimension" }
    },
    "motion": {
      "fast":         { "$value": "{primitive.motion.duration.fast}",   "$type": "duration" },
      "standard":     { "$value": "{primitive.motion.duration.normal}", "$type": "duration" },
      "slow":         { "$value": "{primitive.motion.duration.slow}",   "$type": "duration" },
      "easeStandard": { "$value": "{primitive.motion.easing.out}",      "$type": "string" },
      "easeExit":     { "$value": "{primitive.motion.easing.in}",       "$type": "string" }
    },
    "dark": {
      "comment": "Dark theme = separate design, not an inversion (knowledge/dark-theme-rules). Solid values pre-computed from the overlay model so checks can parse them: text 87/60/38% over #121212, borders 12% over #121212, action lightened 40% + desaturated.",
      "color": {
        "canvas":            { "$value": "#121212", "$type": "color" },
        "canvasRaised":      { "$value": "#1e1e1e", "$type": "color" },
        "ink":               { "$value": "#e0e0e0", "$type": "color" },
        "inkMuted":          { "$value": "#a0a0a0", "$type": "color" },
        "actionPrimary":     { "$value": "#6fa68c", "$type": "color" },
        "actionPrimaryText": { "$value": "#121212", "$type": "color" },
        "focusRing":         { "$value": "{primitive.color.accent.300}", "$type": "color" },
        "borderSubtle":      { "$value": "#2e2e2e", "$type": "color" },
        "surfaceDark":       { "$value": "#121212", "$type": "color" },
        "inkOnDark":         { "$value": "#e0e0e0", "$type": "color" },
        "textPrimary":       { "$value": "#e0e0e0", "$type": "color" },
        "textSecondary":     { "$value": "#a0a0a0", "$type": "color" },
        "textTertiary":      { "$value": "#6c6c6c", "$type": "color" },
        "semanticError":     { "$value": "{primitive.color.semantic.error.dark}",   "$type": "color" },
        "semanticSuccess":   { "$value": "{primitive.color.semantic.success.dark}", "$type": "color" },
        "semanticWarning":   { "$value": "{primitive.color.semantic.warning.dark}", "$type": "color" },
        "semanticInfo":      { "$value": "{primitive.color.semantic.info.dark}",    "$type": "color" }
      }
    }
  },
  "component": {
    "comment": "Component layer (v7.0, A.21): references semantic tokens ONLY — never primitives directly. compile-tokens.py fails the build otherwise.",
    "button": {
      "primaryBg":   { "$value": "{semantic.color.actionPrimary}",     "$type": "color" },
      "primaryText": { "$value": "{semantic.color.actionPrimaryText}", "$type": "color" },
      "radius":      { "$value": "{semantic.radius.control}",          "$type": "dimension" }
    },
    "card": {
      "bg":     { "$value": "{semantic.color.canvasRaised}",  "$type": "color" },
      "border": { "$value": "{semantic.color.borderSubtle}",  "$type": "color" },
      "radius": { "$value": "{semantic.radius.card}",         "$type": "dimension" },
      "shadow": { "$value": "{semantic.shadow.raised}",       "$type": "string" }
    },
    "input": {
      "border":    { "$value": "{semantic.color.borderSubtle}", "$type": "color" },
      "focusRing": { "$value": "{semantic.color.focusRing}",    "$type": "color" }
    }
  }
}
